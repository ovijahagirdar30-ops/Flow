<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ── Notifications ───────────────────────────────────── -->
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Screen wake for the full-screen check-in — ACQUIRE_CAUSES_WAKEUP is how
         CheckinActivity lights the display when the trigger fires with the
         screen off (HyperOS ignores the turnScreenOn flag for background starts).
         Also merged in from a library, declared here explicitly so it can never
         silently disappear. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- ── Exact alarms ──────────────────────────────────────────────────── -->
    <!--
        USE_EXACT_ALARM (Android 13+): granted automatically, no runtime prompt needed.
        SCHEDULE_EXACT_ALARM (Android 12): shown in system settings; we redirect the
        user there from the in-app permission settings button.
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"
        tools:ignore="ExactAlarm" />

    <!-- ── Boot (to reschedule alarms after reboot) ───────────────────────── -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- ── Check-in trigger (feature:checkin) ─────────────────────────────
         Both proven in the standalone Phase 0 test project: USE_FULL_SCREEN_INTENT
         is the lock-screen path, SYSTEM_ALERT_WINDOW is what lets the check-in
         interrupt the user even while the phone is unlocked and in another app. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- ── Location (geofence-based check-in trigger) ─────────────────────
         ACCESS_FINE_LOCATION must be granted first, at runtime. Android then
         requires ACCESS_BACKGROUND_LOCATION as a SEPARATE runtime request
         (routes the user to system settings to pick "Allow all the time") —
         geofence transitions only fire while the app isn't in the foreground
         if background location is granted. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />


    <application
        android:name=".FlowStateApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/new_ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/new_ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FlowState">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.App.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The check-in screen (feature:checkin) — launched directly by
             CheckinAlarmReceiver, needs to appear over the lock screen too -->
        <activity
            android:name=".feature.checkin.CheckinActivity"
            android:exported="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true" />

        <!-- Fires the check-in alarm (debug test only) — targeted
             by CheckinAlarmScheduler (core:notifications) via its class name as
             a string, since core modules don't depend on feature modules -->
        <receiver
            android:name=".feature.checkin.CheckinAlarmReceiver"
            android:exported="false" />

        <!-- Fires when the device enters the home geofence — the primary
             check-in trigger. Targeted the same way, by class-name string. -->
        <receiver
            android:name=".feature.checkin.GeofenceReceiver"
            android:exported="false" />

        <!-- Fires the notification when the alarm triggers -->
        <receiver
            android:name=".core.notifications.ReminderReceiver"
            android:exported="false" />

        <!-- Marks a task as done from the notification "Complete" action -->
        <receiver
            android:name=".core.notifications.CompleteTaskReceiver"
            android:exported="false" />

        <!-- Reprograms alarms after device reboot -->
        <receiver
            android:name=".core.notifications.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <!-- Some HTC / fast-boot devices use this action instead -->
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

    </application>

</manifest>